# Copy this file to .env and fill in your own MongoDB Atlas connection string.
# Never commit the real .env file.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/kaypohkaki?retryWrites=true&w=majority
PORT=4000

# Optional — get a free key at https://newsdata.io/register.
# Without it, the feed just uses CNA's RSS alone.
NEWSDATA_API_KEY=
